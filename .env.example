NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Preferred provider for full historical prices and provider dividend events.
MARKET_DATA_PROVIDER=eodhd
EODHD_API_TOKEN=

# Optional fallback provider.
ALPHA_VANTAGE_API_KEY=
# Generic fallback used by either provider when the provider-specific key is not set.
MARKET_DATA_API_KEY=

# Alpha Vantage only: use compact for free/low-volume plans, full when your provider plan supports full history.
MARKET_DATA_OUTPUT_SIZE=compact
# Delay between price and dividend requests for provider rate limits.
MARKET_DATA_REQUEST_DELAY_MS=1200
